let workloadId = "coding-agent";
let period = "2026-09";

let OutcomeEvidence =
    datatable(
        WorkloadId:string,
        Period:string,
        OutcomeId:string,
        Metric:string,
        Unit:string,
        BaselineValue:real,
        ObservedValue:real,
        OutcomeChange:string,
        EvidenceStatus:string,
        AttributionMethod:string,
        AttributionStatus:string
    )
    [
        "coding-agent", "2026-09", "cycle_time",
        "engineering_task_cycle_time", "hours",
        16.0, 12.0, "-25%",
        "OBSERVED", "matched_comparison", "ATTRIBUTED",

        "coding-agent", "2026-09", "rework_rate",
        "engineering_rework_rate", "percent",
        20.0, 15.0, "-5pp",
        "OBSERVED", "before_after", "OBSERVED",

        "coding-agent", "2026-09", "deployment_throughput",
        "successful_deployments_per_period", "deployments",
        80.0, 96.0, "+20%",
        "OBSERVED", "matched_comparison", "ATTRIBUTED"
    ];

let ValueEvidence =
    datatable(
        WorkloadId:string,
        Period:string,
        ValueId:string,
        Metric:string,
        Unit:string,
        Amount:real,
        ValueMethod:string,
        DerivedFromOutcomeIds:string,
        EvidenceStatus:string
    )
    [
        "coding-agent", "2026-09", "engineering_capacity_value",
        "engineering_capacity_value", "USD",
        180000.0, "modeled_from_cycle_time_reduction",
        "cycle_time", "MODELED",

        "coding-agent", "2026-09", "avoided_rework_cost",
        "avoided_engineering_rework_cost", "USD",
        70000.0, "modeled_from_rework_reduction",
        "rework_rate", "MODELED",

        "coding-agent", "2026-09", "delivery_capacity_value",
        "delivery_capacity_value", "USD",
        120000.0, "modeled_from_deployment_throughput",
        "deployment_throughput", "MODELED"
    ];

let OutcomeGaps =
    OutcomeEvidence
    | where WorkloadId == workloadId and Period == period
    | where EvidenceStatus != "INCREMENTAL"
        or AttributionStatus != "INCREMENTAL"
    | extend
        GapType = case(
            EvidenceStatus == "UNKNOWN", "MISSING_EVIDENCE",
            EvidenceStatus == "MODELED", "MODELED_ONLY",
            AttributionStatus == "UNKNOWN", "ATTRIBUTION_UNKNOWN",
            AttributionStatus == "OBSERVED", "ATTRIBUTION_NEEDS_STRENGTHENING",
            AttributionStatus == "ATTRIBUTED", "INCREMENTAL_PROOF_OPPORTUNITY",
            "EVIDENCE_NEEDS_REVIEW"
        )
    | extend
        ProofNeeded = case(
            GapType == "MISSING_EVIDENCE",
                "Collect direct evidence for the outcome.",
            GapType == "MODELED_ONLY",
                "Observe the outcome in production.",
            GapType == "ATTRIBUTION_UNKNOWN",
                "Define and execute an attribution method.",
            GapType == "ATTRIBUTION_NEEDS_STRENGTHENING",
                "Use a stronger comparison or experiment to support attribution.",
            GapType == "INCREMENTAL_PROOF_OPPORTUNITY",
                "Establish a credible counterfactual to estimate incremental impact.",
            "Review the evidence and attribution supporting this claim."
        )
    | project
        RecordType = "OUTCOME",
        ClaimId = OutcomeId,
        Metric,
        EvidenceStatus,
        AttributionStatus,
        GapType,
        ProofNeeded;

let ValueGaps =
    ValueEvidence
    | where WorkloadId == workloadId and Period == period
    | where EvidenceStatus != "INCREMENTAL"
    | extend
        GapType = case(
            EvidenceStatus == "UNKNOWN", "MISSING_EVIDENCE",
            EvidenceStatus == "MODELED", "MODELED_VALUE_ONLY",
            EvidenceStatus == "OBSERVED", "VALUE_NOT_ATTRIBUTED",
            EvidenceStatus == "ATTRIBUTED", "INCREMENTAL_PROOF_OPPORTUNITY",
            "EVIDENCE_NEEDS_REVIEW"
        )
    | extend
        ProofNeeded = case(
            GapType == "MISSING_EVIDENCE",
                "Collect evidence supporting the value claim.",
            GapType == "MODELED_VALUE_ONLY",
                "Validate the modeled value against observed business results.",
            GapType == "VALUE_NOT_ATTRIBUTED",
                "Establish whether the observed value is attributable to the AI workload.",
            GapType == "INCREMENTAL_PROOF_OPPORTUNITY",
                "Estimate the value relative to a credible counterfactual.",
            "Review the evidence supporting this value claim."
        )
    | project
        RecordType = "VALUE",
        ClaimId = ValueId,
        Metric,
        EvidenceStatus,
        AttributionStatus = "",
        GapType,
        ProofNeeded;

union OutcomeGaps, ValueGaps
| order by RecordType asc, ClaimId asc
