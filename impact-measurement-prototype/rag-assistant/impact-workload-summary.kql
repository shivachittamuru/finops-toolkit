
let workloadId = "rag-assistant";
let period = "2026-09";

let WorkEvidence =
    datatable(
        WorkloadId:string,
        Period:string,
        AttemptedWorkUnits:long,
        AcceptedWorkUnits:long
    )
    [
        "rag-assistant", "2026-09", 20000, 15000
    ];

let WorkloadCost =
    datatable(
        WorkloadId:string,
        Period:string,
        EffectiveCost:real
    )
    [
        "rag-assistant", "2026-09", 60000.0
    ];

let WorkSummary =
    WorkEvidence
    | where WorkloadId == workloadId and Period == period
    | extend
        AcceptanceRate =
            iff(
                AttemptedWorkUnits == 0,
                real(null),
                todouble(AcceptedWorkUnits) / todouble(AttemptedWorkUnits)
            );

let CostSummary =
    WorkloadCost
    | where WorkloadId == workloadId and Period == period;

WorkSummary
| join kind=leftouter CostSummary on WorkloadId, Period
| extend
    CostPerAcceptedWorkUnit =
        iff(
            AcceptedWorkUnits == 0,
            real(null),
            EffectiveCost / todouble(AcceptedWorkUnits)
        )
| project
    WorkloadId,
    Period,
    AttemptedWorkUnits,
    AcceptedWorkUnits,
    AcceptanceRate,
    EffectiveCost,
    CostPerAcceptedWorkUnit